# Public application URL used for links and origin checks.
APP_URL=http://localhost:3000

# Set automatically by the runtime in most environments.
NODE_ENV=development

# Local PostgreSQL connection used by Drizzle and the application.
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/ai_job_hunter

# Generate a unique value of at least 32 characters for every deployed environment.
AUTH_SECRET=replace-with-a-long-random-secret

# Private local storage for development. Production will use the storage adapter with S3/R2.
RESUME_STORAGE_PATH=.data/resumes
RESUME_MAX_FILE_BYTES=5242880
RESUME_MAX_FILES_PER_USER=10

# Comma-separated, explicitly allowlisted public Greenhouse board tokens.
JOB_SOURCE_GREENHOUSE_ENABLED=false
JOB_SOURCE_GREENHOUSE_BOARDS=
JOB_SOURCE_REQUEST_TIMEOUT_MS=15000

# Long random secret used by scheduled internal ingestion requests.
CRON_SECRET=replace-with-a-long-random-cron-secret
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
