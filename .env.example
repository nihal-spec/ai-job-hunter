# Public application URL used for links and origin checks.
APP_URL=http://localhost:3000

# Set automatically by the runtime in most environments.
NODE_ENV=development

# Local PostgreSQL connection used by Drizzle and the application.
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/ai_job_hunter

# Generate a unique value of at least 32 characters for every deployed environment.
AUTH_SECRET=replace-with-a-long-random-secret

# Private local storage for development.
RESUME_STORAGE_PATH=.data/resumes
RESUME_MAX_FILE_BYTES=5242880
RESUME_MAX_FILES_PER_USER=10

# Set STORAGE_PROVIDER=s3 in production (works with AWS S3, Cloudflare R2, or any S3-compatible
# provider) and fill in the fields below. Local disk storage does not survive on serverless hosts.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Comma-separated, explicitly allowlisted public Greenhouse board tokens.
JOB_SOURCE_GREENHOUSE_ENABLED=false
JOB_SOURCE_GREENHOUSE_BOARDS=
JOB_SOURCE_REQUEST_TIMEOUT_MS=15000

# Long random secret used by scheduled internal ingestion requests.
CRON_SECRET=replace-with-a-long-random-cron-secret
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Optional. Leave AI_TEXT_PROVIDER/AI_EMBEDDING_PROVIDER as "none" to run fully deterministic
# (no external AI calls, no API key required). Set to "openai" and provide AI_API_KEY to enable
# AI-assisted resume parsing, embeddings-based matching, and LLM-backed application materials.
AI_TEXT_PROVIDER=none
AI_TEXT_MODEL=gpt-4o-mini
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DAILY_USER_QUOTA=50

# Optional. Without these, signup/login work but skip email verification and password-reset
# emails silently log a warning instead of sending (see src/server/auth/index.ts).
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
